<% layout('/layouts/boilerplate') %>
  <div class="row">
    <h1 class="col-6 offset-4">LOGIN</h1>
    <div class="col-6 offset-2">
<form action="/login" method="post" class="needs-validation" novalidate>
    <div class="mb-3">
      <label for="username" class="form-label" >Username:</label>
    <input   type="text"  name="username" placeholder="Enter the Username" class="form-control" required><br><hr>
      </div>
    
       <div class="mb-3">
      <label for="password" class="form-label" >Password:</label>
    <input   type="password"  name="password" placeholder="Enter the Password" class="form-control" required><br><hr>
      </div>
 
  <button class="btn btn-success"> Login</button>
      </form>
</div>
      </div>

    